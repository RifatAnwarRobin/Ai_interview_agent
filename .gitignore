# =============================================
# Python-Specific Ignores
# =============================================

# Ignore Python's compiled bytecode and cache
# (These are auto-generated and not needed in version control)
__pycache__/
*.py[cod]
*$py.class

# Ignore distribution and packaging artifacts
# (Generated by tools like pip, setuptools, or build systems)
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================
# Virtual Environments
# =============================================

# Ignore virtual environment folders
# (These are local to your machine and can be recreated using requirements.txt)
mors/
.env/
.venv/
ENV/
env/
env.bak/
venv.bak/

# =============================================
# IDE and Editor-Specific Files
# =============================================

# Ignore IDE-specific configuration and temporary files
# (These are user-specific and not needed for the project to run)
.idea/          # PyCharm
.vscode/        # VS Code
*.swp           # Vim swap files
*.swo           # Vim swap files

# =============================================
# Logs and Databases
# =============================================

# Ignore log files and local databases
# (Logs are temporary, and databases can be regenerated or are environment-specific)
*.log
*.sqlite
*.db

# =============================================
# Operating System Files
# =============================================

# Ignore OS-generated files
# (These are not relevant to the project)
.DS_Store       # macOS
Thumbs.db        # Windows
desktop.ini      # Windows

# =============================================
# Environment and Configuration Files
# =============================================

# Ignore environment variable files
# (These often contain sensitive information like API keys or credentials)
.env
.env.local
.env.development
.env.test
.env.production

# Ignore local configuration files
# (These may contain environment-specific settings)
config.ini
config.yml

# =============================================
# Jupyter Notebook Files
# =============================================

# Ignore Jupyter Notebook checkpoints
# (These are auto-saved files and not needed for version control)
.ipynb_checkpoints/

# =============================================
# FastAPI and Streamlit-Specific Ignores
# =============================================

# Ignore additional Python cache and compiled files
# (Redundant and auto-generated)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore FastAPI log files
# (Logs are temporary and can be regenerated)
logs/
*.log

# Ignore Streamlit cache directory
# (This folder contains temporary files and can be regenerated)
.streamlit/

# =============================================
# Data Files
# =============================================

# Ignore raw data files
# (Data files can be large and are often regenerated or downloaded separately)
# If you want to include sample data, add it to a `data/sample/` directory
# and explicitly include it in Git.
# data/
# *.csv
# *.json
# *.xlsx
# *.pkl
# *.h5
# *.joblib
# *.npy
